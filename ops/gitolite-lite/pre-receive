#!/usr/bin/env bash
# The doorman. Reject any push that changes the access-control files
# (addressbook.json; gated.json, which says whose device keys may hold
# human-only entries; and personas.json, which says whose devices are
# one person, so that a new secret and `cards` reach all of them)
# unless the pusher is an admin.
#
# Identity comes from RAGEVEIL_FP, set by the rageveil-shell forced
# command. Admins are listed by fingerprint in ~/admins, which lives
# OUTSIDE the repo, so no push can grant itself admin. Regular users can
# still push secrets (.age files); only the address book is gated —
# that's the line between "uses secrets" and "controls who has access".
set -euo pipefail

REPO="${RAGEVEIL_REPO:-$HOME/.rageveil}"
ADMINS="$HOME/admins"
# Each with its detached signature, which every signed client verifies:
# a member who could push a broken one would stop everyone loading it.
GUARDED="addressbook.json addressbook.json.sig gated.json gated.json.sig personas.json personas.json.sig"
EMPTY_TREE="4b825dc642cb6eb9a060e54bf8d69288fbee4904"   # git's well-known empty tree
me="${RAGEVEIL_FP:-}"

is_admin() {
  [ -n "$me" ] || return 1
  [ -f "$ADMINS" ] || return 1
  grep -qxF "$me" "$ADMINS"
}

reject() {
  echo "rageveil: $1 is admin-only — push rejected (you=${me:-unknown})." >&2
  echo "rageveil: ask an admin to make the change (rageveil address … or" >&2
  echo "rageveil: rageveil persona …), or have your fingerprint added to" >&2
  echo "rageveil: ~git/admins on the server." >&2
  exit 1
}

while read -r oldrev newrev refname; do
  [ "$refname" = "refs/heads/main" ] || continue
  base="$oldrev"
  case "$oldrev" in *[!0]*) ;; *) base="$EMPTY_TREE" ;; esac   # all-zeros => new branch
  # `git diff --quiet` exits 0 if the path is unchanged, 1 if it changed.
  changed="$(git --git-dir="$REPO" diff --name-only "$base" "$newrev" -- $GUARDED | tr '\n' ' ')"  # word-split on purpose: one pathspec per file
  [ -n "$changed" ] || continue
  is_admin || reject "${changed% }"
done
exit 0
